# Use the same OpenRouter account for speech transcription and text formatting.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=https://lecturescribe.app
OPENROUTER_APP_NAME=LectureScribe AI
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_SECONDS=300

# Cloud transcription is the default. Both processing modes use these settings.
WHISPER_BACKEND=openrouter
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_TRANSCRIPTION_TIMEOUT_SECONDS=120
OPENROUTER_AUDIO_CHUNK_SECONDS=300

# Local fallback uses CUDA when available, otherwise CPU int8.
# Disable on small cloud servers that cannot run a local speech model.
WHISPER_LOCAL_FALLBACK=true
OLLAMA_LOCAL_FALLBACK=true
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# WHISPER_MODEL_PATH=/path/to/local/model
# FFMPEG_BIN=/path/to/ffmpeg/bin
